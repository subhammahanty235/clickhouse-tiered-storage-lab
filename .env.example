# Credentials handed to clickhouse-server AND the aws CLI in scripts/.
# ClickHouse reads these via <use_environment_credentials>true</use_environment_credentials>.
#
# ---- Local MinIO (default for this lab) ----
AWS_ACCESS_KEY_ID=chlabaccess
AWS_SECRET_ACCESS_KEY=chlabsecret123
AWS_REGION=us-east-1

# Full bucket+prefix URL, trailing slash REQUIRED.
# 'minio' is the compose service hostname, resolvable from the clickhouse container.
S3_ENDPOINT=http://minio:9000/ch-s3-lab/events/

# Endpoint the *host* aws CLI uses to reach the same store (verify.sh / teardown.sh).
# Leave empty when pointing at real AWS S3.
S3_CLI_ENDPOINT=http://127.0.0.1:9000

# ---- Real AWS S3: comment out the MinIO block above and use ----
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
# AWS_REGION=us-east-1
# S3_ENDPOINT=https://my-bucket.s3.us-east-1.amazonaws.com/ch-s3-lab/events/
# S3_CLI_ENDPOINT=
